# config/production.env — values for the `production` environment.
#
# This is the single source of truth for everything that varies per
# deployment: the domain, worker name, Cloudflare resource IDs.
# `mise run wrangler:generate` reads this file + every other file in
# config/*.env to render worker/wrangler.toml (which is gitignored).
#
# When you fork this repo for a new domain:
#   1. Copy config/template.env → config/production.env (or whatever env name)
#   2. Fill in DOMAIN, WORKER_NAME, GH_REPO
#   3. mise run cf:provision -- --env production
#      (creates D1 + KV + writes IDs back here)
#   4. mise run 10-deploy

# ── Identity ─────────────────────────────────────────────────────────────────
# Parent domain hosting this auth service. Must be registered on Cloudflare
# DNS (so cookies can span subdomains and SPF/DKIM/DMARC auto-provision).
DOMAIN=ubuntusoftware.net

# Cloudflare Worker name. Must be unique within your CF account.
# Service Bindings from consumer Workers reference this exact name.
WORKER_NAME=auth-better-worker

# Subdomain serving the auth UI + API. Resolves to: ${SUBDOMAIN_AUTH}.${DOMAIN}
SUBDOMAIN_AUTH=auth

# Subdomain registered with Cloudflare Email Service for outbound mail.
# CF Email Service requires a subdomain (apex is reserved for Email Routing).
# Resolves to: ${SUBDOMAIN_MAIL}.${DOMAIN}
SUBDOMAIN_MAIL=mail

# Subdomain that catches inbound test emails (ADR-007 test sink). e2e tests
# poll /auth/test/inbox?email=foo@${SUBDOMAIN_TEST}.${DOMAIN} for OTPs/links.
# Resolves to: ${SUBDOMAIN_TEST}.${DOMAIN}
SUBDOMAIN_TEST=test

# Local part of the email From address. Resolves to:
# ${EMAIL_FROM_LOCAL}@${SUBDOMAIN_MAIL}.${DOMAIN}
EMAIL_FROM_LOCAL=noreply
EMAIL_FROM_NAME=Auth

# GitHub repo (owner/name) — used by secrets:sync-github + CI workflows.
GH_REPO=joeblew999/auth-service

# ── Cloudflare resource IDs ──────────────────────────────────────────────────
# Filled in by `mise run cf:provision`. Don't edit by hand unless you know
# what you're doing — wrangler.toml binds these by ID, and changing the ID
# silently disconnects the binding from real data.

# D1 database (sqlite). holds users, sessions, orgs, members, etc.
D1_DATABASE_NAME=auth-better-db
D1_DATABASE_ID=69f62edf-88ec-41ef-be41-4dd341b2da0d

# KV namespace. holds session secondary cache + ADR-007 test inbox.
KV_NAMESPACE_NAME=AUTH_KV
KV_NAMESPACE_ID=476719674e124d6b9f5e70965cb017d0
