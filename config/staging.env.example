# config/staging.env.example — copy to config/staging.env, fill in YOUR
# domain, then run `mise run cf:provision -- --env staging` to create
# the D1 + KV + custom domain. NOT committed (.example suffix).
#
# Multi-env model: each config file = one fully isolated deploy.
# - separate worker (different name)
# - separate D1 database + data
# - separate KV namespace + sessions
# - separate custom domain + cookie scope
# - sessions never cross envs

DOMAIN=staging.YOUR-DOMAIN.com
WORKER_NAME=auth-staging-worker
SUBDOMAIN_AUTH=auth
SUBDOMAIN_MAIL=mail
SUBDOMAIN_TEST=test
EMAIL_FROM_LOCAL=noreply
EMAIL_FROM_NAME=Auth (staging)
GH_REPO=joeblew999/auth-service

# Filled in by `mise run cf:provision -- --env staging`.
D1_DATABASE_NAME=auth-staging-db
D1_DATABASE_ID=
KV_NAMESPACE_NAME=AUTH_KV
KV_NAMESPACE_ID=
