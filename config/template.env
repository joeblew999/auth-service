# config/template.env — schema for forking this repo to a new domain.
#
# Copy this to config/<env>.env (e.g. config/staging.env or config/production.env),
# fill in the values up to "Cloudflare resource IDs", then run:
#
#   mise run cf:provision -- --env <env>     # creates D1 + KV + custom domain
#   mise run 10-deploy -- --env <env>
#
# Every other mise task accepts `-- --env <env>` to switch which config file
# it reads. The default is `production`.
#
# All values below are placeholders — DO NOT COMMIT this file with real
# values. Copy + fill a real config/<env>.env instead.

# ── Identity ─────────────────────────────────────────────────────────────────

# Parent domain. Must be on Cloudflare DNS.
DOMAIN=example.com

# Cloudflare Worker name (must be unique in your CF account).
WORKER_NAME=my-auth-worker

# Subdomains
SUBDOMAIN_AUTH=auth        # auth UI + API (auth.example.com)
SUBDOMAIN_MAIL=mail        # CF Email Service sender (mail.example.com)
SUBDOMAIN_TEST=test        # e2e inbound sink (*@test.example.com)

# Email From identity
EMAIL_FROM_LOCAL=noreply   # → noreply@mail.example.com
EMAIL_FROM_NAME=Auth

# GitHub repo for CI + secrets sync
GH_REPO=your-org/your-repo

# ── Cloudflare resource IDs (set by `mise run cf:provision`) ────────────────

D1_DATABASE_NAME=
D1_DATABASE_ID=

KV_NAMESPACE_NAME=AUTH_KV
KV_NAMESPACE_ID=
