# ─────────────────────────────────────────────────────────
# ${WORKER_NAME} — generated from worker/wrangler.toml.template
# ─────────────────────────────────────────────────────────
#
# DO NOT EDIT THIS GENERATED FILE.
# Edit config/<env>.env then re-run `mise run wrangler:generate`.
# ─────────────────────────────────────────────────────────

name = "${WORKER_NAME}"
main = "src/index.ts"
compatibility_date = "2025-10-08"
compatibility_flags = ["nodejs_compat"]
workers_dev = true

# Workers Logs — captures console.* + uncaught errors for the
# cloudflare-observability MCP and dashboard. Without this block
# `wrangler tail` works but logs are NOT persisted/queryable.
[observability]
enabled = true
head_sampling_rate = 1.0

# Static assets — built React SPA served by the worker in production.
[assets]
directory = "../web/dist"
not_found_handling = "single-page-application"

# ── Local dev bindings ────────────────────────────────────────────────────────
# "local" is a wrangler miniflare placeholder — no real Cloudflare IDs needed.

[[d1_databases]]
binding       = "AUTH_DB"
database_name = "${D1_DATABASE_NAME}"
database_id   = "local"

[[kv_namespaces]]
binding = "AUTH_KV"
id      = "local"

[vars]
BETTER_AUTH_URL        = "http://localhost:8792"
AUTH_BETTER_WEB_PORT   = "5174"
AUTH_EMAIL_FROM        = "${EMAIL_FROM_LOCAL}@${DOMAIN}"
AUTH_EMAIL_FROM_NAME   = "${EMAIL_FROM_NAME}"
AUTH_TEST_SINK_ENABLED = "true"
TEST_SINK_DOMAIN       = "${SUBDOMAIN_TEST}.${DOMAIN}"

# CF Email Service binding (ADR-006).
[[send_email]]
name = "SEND_EMAIL"

# ── Production ────────────────────────────────────────────────────────────────

[env.production]
name = "${WORKER_NAME}"
routes = [
  { pattern = "${SUBDOMAIN_AUTH}.${DOMAIN}", custom_domain = true },
]

[env.production.vars]
BETTER_AUTH_URL        = "https://${SUBDOMAIN_AUTH}.${DOMAIN}"
AUTH_EMAIL_FROM        = "${EMAIL_FROM_LOCAL}@${SUBDOMAIN_MAIL}.${DOMAIN}"
AUTH_EMAIL_FROM_NAME   = "${EMAIL_FROM_NAME}"
AUTH_TEST_SINK_ENABLED = "true"
COOKIE_DOMAIN          = ".${DOMAIN}"
TEST_SINK_DOMAIN       = "${SUBDOMAIN_TEST}.${DOMAIN}"

# Assets binding must be re-declared per-environment — wrangler doesn't
# inherit the top-level [assets] block.
[env.production.assets]
directory          = "../web/dist"
binding            = "ASSETS"
not_found_handling = "single-page-application"

[env.production.observability]
enabled = true
head_sampling_rate = 1.0

[[env.production.send_email]]
name = "SEND_EMAIL"

[[env.production.d1_databases]]
binding       = "AUTH_DB"
database_name = "${D1_DATABASE_NAME}"
database_id   = "${D1_DATABASE_ID}"

[[env.production.kv_namespaces]]
binding = "${KV_NAMESPACE_NAME}"
id      = "${KV_NAMESPACE_ID}"

[dev]
ip             = "::"
port           = 8792
inspector_port = 9233
local_protocol = "http"
